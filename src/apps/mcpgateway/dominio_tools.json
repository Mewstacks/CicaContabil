 {
  "annotations": {
   "destructiveHint": false,
   "readOnlyHint": true
  },
  "description": "Consulta em JSON (tabela, colunas, filtros, agrupamento, agregação, junção por FK).",
  "inputSchema": {
   "$defs": {
    "Agregacao": {
     "additionalProperties": false,
     "properties": {
      "alias": {
       "description": "nome da coluna no resultado (letras, numeros e _)",
       "maxLength": 200,
       "title": "Alias",
       "type": "string"
      },
      "coluna": {
       "description": "coluna, ou * so com count",
       "maxLength": 200,
       "title": "Coluna",
       "type": "string"
      },
      "funcao": {
       "enum": [
        "count",
        "sum",
        "avg",
        "min",
        "max",
        "count_distinct"
       ],
       "title": "Funcao",
       "type": "string"
      }
     },
     "required": [
      "funcao",
      "coluna",
      "alias"
     ],
     "title": "Agregacao",
     "type": "object"
    },
    "ConsultaEstruturada": {
     "additionalProperties": false,
     "properties": {
      "agregacoes": {
       "items": {
        "$ref": "#/$defs/Agregacao"
       },
       "maxItems": 10,
       "title": "Agregacoes",
       "type": "array"
      },
      "agrupar_por": {
       "items": {
        "maxLength": 200,
        "type": "string"
       },
       "maxItems": 10,
       "title": "Agrupar Por",
       "type": "array"
      },
      "colunas": {
       "items": {
        "maxLength": 200,
        "type": "string"
       },
       "maxItems": 40,
       "title": "Colunas",
       "type": "array"
      },
      "deslocamento": {
       "default": 0,
       "minimum": 0,
       "title": "Deslocamento",
       "type": "integer"
      },
      "distinto": {
       "default": false,
       "title": "Distinto",
       "type": "boolean"
      },
      "filtros": {
       "items": {
        "$ref": "#/$defs/Filtro"
       },
       "maxItems": 20,
       "title": "Filtros",
       "type": "array"
      },
      "juntar": {
       "items": {
        "$ref": "#/$defs/Juncao"
       },
       "maxItems": 2,
       "title": "Juntar",
       "type": "array"
      },
      "limite": {
       "anyOf": [
        {
         "minimum": 1,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Limite"
      },
      "ordenar_por": {
       "items": {
        "$ref": "#/$defs/Ordem"
       },
       "maxItems": 5,
       "title": "Ordenar Por",
       "type": "array"
      },
      "tabela": {
       "maxLength": 200,
       "title": "Tabela",
       "type": "string"
      }
     },
     "required": [
      "tabela"
     ],
     "title": "ConsultaEstruturada",
     "type": "object"
    },
    "Filtro": {
     "additionalProperties": false,
     "properties": {
      "coluna": {
       "description": "coluna da tabela base ou apelido.coluna",
       "maxLength": 200,
       "title": "Coluna",
       "type": "string"
      },
      "op": {
       "enum": [
        "=",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        "in",
        "between",
        "prefix",
        "contains",
        "is_null",
        "not_null"
       ],
       "title": "Op",
       "type": "string"
      },
      "valor": {
       "default": null,
       "description": "escalar, lista (in) ou par [de, ate] (between)",
       "title": "Valor"
      }
     },
     "required": [
      "coluna",
      "op"
     ],
     "title": "Filtro",
     "type": "object"
    },
    "Juncao": {
     "additionalProperties": false,
     "properties": {
      "apelido": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Apelido"
      },
      "tabela": {
       "maxLength": 200,
       "title": "Tabela",
       "type": "string"
      }
     },
     "required": [
      "tabela"
     ],
     "title": "Juncao",
     "type": "object"
    },
    "Ordem": {
     "additionalProperties": false,
     "properties": {
      "coluna": {
       "description": "coluna do resultado, apelido de agregacao ou coluna",
       "maxLength": 200,
       "title": "Coluna",
       "type": "string"
      },
      "ordem": {
       "default": "asc",
       "enum": [
        "asc",
        "desc"
       ],
       "title": "Ordem",
       "type": "string"
      }
     },
     "required": [
      "coluna"
     ],
     "title": "Ordem",
     "type": "object"
    }
   },
   "properties": {
    "consulta": {
     "$ref": "#/$defs/ConsultaEstruturada"
    }
   },
   "required": [
    "consulta"
   ],
   "title": "consulta_estruturadaArguments",
   "type": "object"
  },
  "name": "consulta_estruturada"
 },
