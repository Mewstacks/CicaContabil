<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>Cica.Agent.Service</AssemblyName>
  </PropertyGroup>
  <!-- Os contratos de consulta viajam dentro do binário, e é o que permite conferir
       o hash antes de executar. O caminho é relativo à raiz do repositório: o
       manifesto que o servidor lê e o que o agente carrega são o mesmo arquivo. -->
  <ItemGroup>
    <ProjectReference Include="../Cica.Agent.Contracts/Cica.Agent.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <PackageReference Include="System.Data.Odbc" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
