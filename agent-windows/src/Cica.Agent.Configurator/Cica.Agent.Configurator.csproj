<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>$(CicaRuntimeVersion)</RuntimeFrameworkVersion>
    <AssemblyName>Cica.Agent.Configurator</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Cica.Agent.Contracts/Cica.Agent.Contracts.csproj" />
    <Compile Include="../Cica.Agent.Service/LocalOdbcConnection.cs" Link="LocalOdbcConnection.cs" />
    <Compile Include="../Cica.Agent.Service/AgentSyncScope.cs" Link="AgentSyncScope.cs" />
    <Compile Include="../Cica.Agent.Service/AtomicConfigurationFile.cs" Link="AtomicConfigurationFile.cs" />
    <Compile Include="../Cica.Agent.Service/AgentAuthentication.cs" Link="AgentAuthentication.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.Odbc" Version="10.0.15" />
  </ItemGroup>
</Project>
