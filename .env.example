# Local development only. Copy to .env and load it in your shell or Docker Compose.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-only-change-me-never-use-in-production
# Includes all temporary Cloudflare Quick Tunnel hostnames (*.trycloudflare.com).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.trycloudflare.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional deployment name for cache-key and Celery-queue prefixes (any host).
# APP_NAME=my-saas
# Client IP resolution behind a proxy / load balancer (host-agnostic). Leave both unset
# when the app is the direct peer. Behind one reverse proxy set TRUSTED_PROXY_COUNT=1; or,
# preferred when the proxy addresses are fixed, list their CIDRs in TRUSTED_PROXY_IPS.
# TRUSTED_PROXY_COUNT=1
# TRUSTED_PROXY_IPS=10.0.0.0/8

# Set DB_ENGINE=sqlite for a zero-dependency quick start.
DB_ENGINE=postgresql
DB_NAME=saas
DB_USER=saas
DB_PASSWORD=local-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL_REQUIRE=false

# Separate database for manuals, approved rules and global training corpus. It must
# not point to the same database as tenant data in production.
KNOWLEDGE_DATABASE_URL=
KNOWLEDGE_DB_SSL_REQUIRE=false

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Generate independent 32-byte keys; never reuse DJANGO_SECRET_KEY.
# Example generation:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FIELD_ENCRYPTION_ACTIVE_KEY_ID=local-v1
FIELD_ENCRYPTION_KEYS={"local-v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
PRIVACY_HMAC_KEY=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET

PRIVACY_REQUEST_TARGET_DAYS=15
ADMIN_ENABLED=true

# Set to None (plus HTTPS) only when the browser client is served from another site.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# Also lock an account out by username alone, which stops a brute force spread over many
# IPs but lets a third party lock somebody out on purpose.
AXES_LOCKOUT_BY_USERNAME=false
# Seconds a readiness result is reused per worker process. 0 disables memoisation.
HEALTH_READINESS_CACHE_SECONDS=5

SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_RELEASE=

# CRMew monitoring: configure one ingest token per Hub web, worker, and Domínio agent.
# Keep these values only in the environment; do not commit production tokens.
MEWPULSE_INGEST_URL=
MEWPULSE_INGEST_TOKEN=
MEWGUARD_POSTURE_URL=

# The internal Copilot runtime origin and credentials are configured in the
# developer console and kept encrypted at rest. Do not add them to this file.
INTELLIGENCE_ATTACHMENT_RETRY_LIMIT=6

# Integra Contador (Serpro). "trial" is the free demonstration gateway.
# The e-CNPJ A1 certificate is presented as the TLS client identity; keep the file
# outside the repository and point to it here.
INTEGRA_ENVIRONMENT=trial
INTEGRA_CONSUMER_KEY=
INTEGRA_CONSUMER_SECRET=
INTEGRA_CERTIFICATE_PATH=
INTEGRA_CERTIFICATE_PASSWORD=
INTEGRA_CONTRATANTE_CNPJ=
INTEGRA_AUTOR_PEDIDO_CNPJ=

# CICA Windows agent. Keep the CA private key outside the repository.
EDGE_AGENT_MTLS_REQUIRED=false
EDGE_AGENT_CA_CERT_PATH=
EDGE_AGENT_CA_KEY_PATH=
EDGE_AGENT_INSTALLER_URL=
EDGE_AGENT_LATEST_VERSION=

# Cobranças são tratadas externamente pela Mewstack e registradas manualmente
# no console CICA. Não configure um provedor de pagamento neste ambiente.
