# Arquivo exclusivo do servidor Cobalchini. Nunca versionar .env.cobalchini.
HUB_IMAGE=ghcr.io/owner/hub-contador@sha256:REPLACE_WITH_APPROVED_IMMUTABLE_DIGEST
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_GENERATED_VALUE
DJANGO_ALLOWED_HOSTS=hub.cobalchini.local
DJANGO_CSRF_TRUSTED_ORIGINS=https://hub.cobalchini.local
DB_NAME=hub
DB_USER=hub
DB_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD
DB_SSL_REQUIRE=false
FIELD_ENCRYPTION_ACTIVE_KEY_ID=prod-v1
FIELD_ENCRYPTION_KEYS={"prod-v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
PRIVACY_HMAC_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_VALUE
SENTRY_ENABLED=false
EDGE_AGENT_MTLS_REQUIRED=true
MEWPULSE_INGEST_URL=
MEWPULSE_INGEST_TOKEN=
MEWGUARD_POSTURE_URL=
# Ative análise local de PDF/imagem com `docker compose --profile ai up -d`.
# A URL abaixo só vale dentro da rede Docker; não publique a porta do adaptador.
LOCAL_LLM_ENDPOINT=http://ollama:11434
LOCAL_LLM_MODEL=qwen2.5vl:7b
LOCAL_MULTIMODAL_ENDPOINT=http://multimodal:8081
LOCAL_MULTIMODAL_MODEL=qwen2.5vl:7b
INTELLIGENCE_ATTACHMENT_RETRY_LIMIT=6
# Fixe por digest uma imagem Ollama aprovada antes de habilitar o perfil AI.
OLLAMA_IMAGE=
# O agente Domínio recebe o DSN somente no Windows Credential Manager, não aqui.
